# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to hash PNRs before storing them. Use a long random string.
PNR_HASH_SECRET=change-me-to-a-long-random-string

# "mock" uses built-in sample flights. Add real providers in src/lib/flights/index.ts.
FLIGHT_PROVIDER=mock
